<!-- The system log tables of a test server: off, but for the query log a test reads, kept an hour. They
     wrote a server's every query, trace and metric to disk for good - a test server's data lives in a tmpfs
     of its container (the Makefile's test_clickhouse_up), which they filled. -->
<clickhouse>
    <!-- The server's own log files, kept small: at the default trace level they filled the log tmpfs and
         the server stopped answering. -->
    <logger>
        <level>warning</level>
        <size>20M</size>
        <count>2</count>
    </logger>
    <query_log>
        <ttl>event_time + INTERVAL 1 HOUR DELETE</ttl>
    </query_log>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <query_metric_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <text_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <processors_profile_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <error_log remove="1"/>
    <latency_log remove="1"/>
    <blob_storage_log remove="1"/>
    <s3queue_log remove="1"/>
    <zookeeper_log remove="1"/>
    <crash_log remove="1"/>
</clickhouse>
