# Created by .ignore support plugin (hsz.mobi)
### Python template
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.pyd
*.pdb
# rust/native*.so (Linux, macOS) and rust/native*.pyd (Windows) are the exception: CI builds them on
# every push to dev/main and commits them back (.github/workflows/ci.yml's commit-native-binary job),
# so a checkout or a service depending on hare-orm as a plain git dependency gets the rust_pg driver
# without a Rust toolchain. Anchored flat under rust/, not rust/native/python/rust/, where `maturin develop` lands.
!/rust/native*.so
!/rust/native*.pyd
.idea
_static
_build
_templates

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

